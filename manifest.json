{
    "manifest_version": 3,
    "name": "AI Studio Workspace Syncer",
    "version": "2.2.0",
    "description": "Sync code blocks from Google AI Studio to your local workspace.",
    "browser_specific_settings": {
        "gecko": {
            "id": "aistudio-sync@local.net",
            "strict_min_version": "115.0"
        }
    },
    "permissions": [
        "storage",
        "clipboardRead"
    ],
    "host_permissions": [
        "https://aistudio.google.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://aistudio.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}